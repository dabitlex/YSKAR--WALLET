<?xml version="1.0" encoding="utf-8"?>
<!--
  Das Zeichen fuer den Startbildschirm - als Ablauf, nicht als Bild.

  Die drei Teile leuchten nacheinander auf: linkes Band, rechtes Band,
  Stamm. Dieselbe Reihenfolge wie beim Entsperren und beim Senden. Wer die
  App oeffnet, sieht in einer halben Sekunde, was das Zeichen den Rest der
  Zeit ueber sagen wird.

  ZUM MASSSTAB: Android gibt dem Startsymbol eine Flaeche von 288 und
  maskiert es zu einem Kreis; ohne eigene Symbolflaeche duerfen die inneren
  192 benutzt werden. Die Vorlage hat den Ausschnitt 187,5 / 184 / 879 / 879.

      Faktor      192 / 879              = 0,218430
      Versatz X   48 - 187,5 * 0,218430  = 7,044
      Versatz Y   48 - 184   * 0,218430  = 7,809

  `fillAlpha` steht bei allen drei Teilen auf 1. Das ist Absicht: Spielt
  ein Geraet den Ablauf nicht ab, steht das Zeichen vollstaendig da statt
  unsichtbar zu sein. Die Animatoren setzen die 0 selbst, bevor sie laufen.

  Die Verlaufskoordinaten stehen im Koordinatenraum DER PFADE, nicht in dem
  der 288er-Flaeche. Siehe symbol_vordergrund.xml.
-->
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">

            <group
                android:scaleX="0.218430"
                android:scaleY="0.218430"
                android:translateX="7.044"
                android:translateY="7.809">

                <path
                    android:name="band_links"
                    android:fillAlpha="1"
                    android:pathData="M727.9 847.0 C797.3 765.8 810.3 667.4 760.3 600.9 C746.5 582.5 735.3 573.0 680.5 532.7 C669.5 524.7 644.3 506.1 624.5 491.4 C604.7 476.8 584.7 462.0 580.0 458.6 C482.6 387.3 367.5 300.7 338.0 276.6 C309.8 253.6 277.6 223.1 254.6 197.5 C249.1 191.4 244.2 186.5 243.6 186.5 C242.0 186.5 241.5 301.3 243.0 317.9 C247.5 367.3 262.8 415.1 285.7 451.2 C311.5 491.7 341.0 518.7 416.5 571.0 C447.3 592.3 445.7 591.2 495.5 626.5 C615.1 711.4 644.9 733.8 665.5 754.4 C695.2 784.2 712.4 815.2 716.1 845.5 C717.9 859.9 717.0 859.8 727.9 847.0 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:startX="275.4"
                            android:startY="184"
                            android:endX="846.75"
                            android:endY="1063"
                            android:type="linear">
                            <item android:offset="0" android:color="#FF63D8FF" />
                            <item android:offset="0.55" android:color="#FF2F7BFF" />
                            <item android:offset="1" android:color="#FF1B4FD1" />
                        </gradient>
                    </aapt:attr>
                </path>

                <path
                    android:name="band_rechts"
                    android:fillAlpha="1"
                    android:pathData="M816.3 594.8 C829.6 582.7 835.3 577.9 854.0 562.9 C934.5 498.6 960.5 472.6 982.2 435.1 C997.2 409.2 1007.7 377.3 1010.9 347.8 C1012.3 335.3 1012.4 254.3 1011.0 253.5 C1010.5 253.2 1003.6 258.2 995.8 264.6 C966.5 288.7 916.7 324.5 833.0 381.5 C786.7 413.1 688.1 481.9 684.2 485.3 C680.9 488.4 681.3 489.1 690.8 496.0 C772.8 556.1 786.1 568.4 800.6 597.2 C804.9 605.7 804.1 605.8 816.3 594.8 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:startX="275.4"
                            android:startY="184"
                            android:endX="846.75"
                            android:endY="1063"
                            android:type="linear">
                            <item android:offset="0" android:color="#FF63D8FF" />
                            <item android:offset="0.55" android:color="#FF2F7BFF" />
                            <item android:offset="1" android:color="#FF1B4FD1" />
                        </gradient>
                    </aapt:attr>
                </path>

                <path
                    android:name="stamm"
                    android:fillAlpha="1"
                    android:pathData="M688.0 969.2 C688.0 850.6 687.5 845.0 673.8 817.5 C659.4 788.7 647.4 777.8 562.0 716.5 C479.0 656.9 470.2 650.8 468.8 651.6 C467.2 652.6 467.8 790.6 469.5 803.3 C475.2 846.9 493.4 880.1 528.5 910.7 C533.5 915.0 545.6 925.8 555.5 934.6 C565.4 943.4 584.5 960.2 598.0 972.0 C641.5 1010.0 659.5 1027.9 677.2 1050.8 C681.6 1056.4 685.8 1061.0 686.6 1061.0 C687.8 1061.0 688.0 1048.0 688.0 969.2 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:startX="275.4"
                            android:startY="184"
                            android:endX="846.75"
                            android:endY="1063"
                            android:type="linear">
                            <item android:offset="0" android:color="#FF63D8FF" />
                            <item android:offset="0.55" android:color="#FF2F7BFF" />
                            <item android:offset="1" android:color="#FF1B4FD1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>

    <!--
      Die Wartezeiten stehen als eigener Animator von 0 nach 0 davor. Mit
      `startOffset` bliebe der Teil waehrend der Wartezeit sichtbar und
      spraenge dann auf 0 - ein Flackern. So steht die 0 sofort.
    -->
    <target android:name="band_links">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="200"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="band_rechts">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="130" />
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="190"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="stamm">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:duration="280" />
                <objectAnimator
                    android:propertyName="fillAlpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="200"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
