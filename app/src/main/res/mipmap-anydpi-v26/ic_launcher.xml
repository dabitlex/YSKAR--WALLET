<?xml version="1.0" encoding="utf-8"?>
<!--
  Das App-Symbol.

  Drei Ebenen: Hintergrundflaeche, das Zeichen, und eine einfarbige Fassung
  fuer die Themensymbole ab Android 13. Nur `mipmap-anydpi-v26` und keine
  PNG-Groessen daneben, weil minSdk 26 ist - aeltere Geraete, die eine
  Rasterfassung braeuchten, gibt es hier nicht.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/symbol_hintergrund" />
    <foreground android:drawable="@drawable/symbol_vordergrund" />
    <monochrome android:drawable="@drawable/symbol_einfarbig" />
</adaptive-icon>
